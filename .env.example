# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database & Queue
DATABASE_URL=postgresql://billsmaster:billsmaster_pass@localhost:5432/billsmaster?schema=public
REDIS_URL=redis://localhost:6379

# Cryptography & Security
# 32-byte hex string (64 hex chars) for AES-256-GCM encryption of provider credentials
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Secret for JWT signing
JWT_SECRET=billsmaster-super-secret-jwt-token-key-2026-secure

# Local Storage Directory for PDFs & Browser Session states
STORAGE_DIR=./storage

# CORS origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Public URL (used for MailScript callbacks and absolute links)
PUBLIC_URL=http://localhost:3000

# Browser automation
PLAYWRIGHT_HEADLESS=true

# Optional: Live integration test credentials (for running *.live.test.ts)
# MYORLEN_LOGIN=
# MYORLEN_PASSWORD=
# NETIA_LOGIN=
# NETIA_PASSWORD=
# AQUA_LOGIN=
# AQUA_PASSWORD=
# TAURON_LOGIN=
# TAURON_PASSWORD=
# EUROLAN_LOGIN=
# EUROLAN_PASSWORD=
# EKARTOTEKA_LOGIN=
# EKARTOTEKA_PASSWORD=
