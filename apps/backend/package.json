{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx src/db/seed.ts",
    "test": "NODE_ENV=test DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://billsmaster:billsmaster_pass@localhost:5433/billsmaster_test?schema=public}\" node --test-concurrency=1 --import tsx --test $(find src -name '*.test.ts' ! -name '*.live.test.ts')",
    "test:live": "NODE_ENV=test node --import tsx --test $(find src -name '*.live.test.ts')"
  },
  "dependencies": {
    "@bills-master/shared-types": "*",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/sensible": "^5.6.0",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^10.0.1",
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.7.15",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "ioredis": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "3.11.174",
    "playwright": "^1.44.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.12",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "prisma": "^5.14.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
